---
// Three-way switch with icons only, so it keeps the same size in every theme.
const THEMES = [
  {
    id: 'light',
    label: 'Light',
    icon: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"/>',
  },
  {
    id: 'dark',
    label: 'Dark',
    icon: '<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"/>',
  },
  {
    id: 'reading',
    label: 'Reading',
    icon: '<path d="M8 4.5C6.5 3.3 4.5 3 2 3v9.5c2.5 0 4.5.3 6 1.5 1.5-1.2 3.5-1.5 6-1.5V3c-2.5 0-4.5.3-6 1.5zM8 4.5V14"/>',
  },
];
---

<div class="theme-toggle" role="group" aria-label="Theme">
  {THEMES.map((t) => (
    <button type="button" data-theme-option={t.id} aria-label={`${t.label} theme`} title={t.label} aria-pressed="false">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
    </button>
  ))}
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    flex-shrink: 0;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
  }

  button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  button:hover {
    color: var(--color-text);
  }

  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  /* Active state comes from <html data-theme>, which is set before first paint. */
  :global([data-theme='light']) button[data-theme-option='light'],
  :global([data-theme='dark']) button[data-theme-option='dark'],
  :global([data-theme='reading']) button[data-theme-option='reading'] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeOption === theme)));
  }

  setTheme(localStorage.getItem('theme') || 'dark');
  buttons.forEach((b) => b.addEventListener('click', () => setTheme(b.dataset.themeOption!)));
</script>
