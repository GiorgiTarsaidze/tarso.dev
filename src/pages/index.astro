---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RepoCard from '../components/RepoCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
const inSection = (section: string) => projects.filter((p) => p.data.section === section);

const ventures = inSection('venture');
const openSource = inSection('open-source');
const hackathonBuilds = inSection('hackathon');

const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const hackathons = (await getCollection('hackathons'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Giorgi Tarsaidze">

  <!-- Ventures -->
  <section class="section">
    <h2 class="section-title">Ventures</h2>
    <div class="card-grid">
      {ventures.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- Open source -->
  <section class="section">
    <h2 class="section-title">Open source</h2>
    <div class="card-grid card-grid-3">
      {openSource.map((p) => <RepoCard project={p} />)}
    </div>
  </section>

  <!-- Hackathon builds -->
  <section class="section">
    <h2 class="section-title">Hackathon builds</h2>
    <ul class="project-list">
      {hackathonBuilds.map((project) => (
        <li class="project-item">
          <a class="project-name" href={project.data.link} target="_blank" rel="noopener noreferrer">
            {project.data.title}
          </a>
          <p class="project-description">{project.data.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Talks & Hackathons — two-column row -->
  <div class="two-column-row">
    <section class="section">
      <h2 class="section-title">Talks</h2>
      {talks.length === 0 ? (
        <p style="color: var(--color-text-secondary)">No talks yet.</p>
      ) : (
        <ul class="simple-list">
          {talks.map((talk) => (
            <li>
              <strong>
                {talk.data.link ? (
                  <a href={talk.data.link} target="_blank" rel="noopener noreferrer">{talk.data.title}</a>
                ) : (
                  talk.data.title
                )}
              </strong>
              <span class="list-meta">{talk.data.event} &middot; {talk.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="section">
      <h2 class="section-title">Hackathons & Events</h2>
      {hackathons.length === 0 ? (
        <p style="color: var(--color-text-secondary)">No events yet.</p>
      ) : (
        <ul class="simple-list">
          {hackathons.map((hack) => (
            <li>
              <strong>
                {hack.data.link ? (
                  <a href={hack.data.link} target="_blank" rel="noopener noreferrer">{hack.data.title}</a>
                ) : (
                  hack.data.title
                )}
              </strong>
              <span class="list-meta">{hack.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })} &middot; {hack.data.description}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>

</BaseLayout>
